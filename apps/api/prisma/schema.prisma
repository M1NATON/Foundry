generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String        @id @default(cuid())
  userId    String
  title     String
  // Пара фраз о замысле ролика. Нужны, когда сценария ещё нет: одного
  // названия внешней модели мало, чтобы написать его с нуля.
  brief     String?       @db.Text
  // Визуальный стиль ролика. null — на проекте не выбран, берётся дефолт
  // пользователя: так уже собранные проекты подхватывают его вкус, а не
  // застревают на стиле, который когда-то выбрала за них модель.
  visualStyle       String?
  visualStyleCustom String? @db.Text
  coverUrl  String?
  status    ProjectStatus @default(DRAFT)
  // Формат кадра таймлайна при экспорте в монтажку: шортсы — PORTRAIT.
  frameFormat FrameFormat @default(LANDSCAPE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  research  Research?
  script    Script?
  scenes    Scene[]
  // Музыка живёт на проекте, а не на сцене: трек тянется через весь ролик
  // независимо от нарезки. Сцена может перебить его своим (Scene.activeMusicId).
  assets    Asset[]
  activeMusicId String?

  @@index([userId, updatedAt])
}

/// Настройки пользователя. FK нет: модели User в приложении не существует —
/// userId это строка, которую отдаёт AuthGuard. `@id` даёт атомарный upsert.
model UserSettings {
  userId                   String  @id
  defaultVisualStyle       String
  defaultVisualStyleCustom String? @db.Text
}

enum ProjectStatus {
  DRAFT
  RESEARCH
  SCRIPTING
  STORYBOARDING
  PRODUCING
  READY
}

enum FrameFormat {
  LANDSCAPE
  PORTRAIT
}

model Research {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sources   Json    @default("[]")
  notes     String? @db.Text
}

model Script {
  id         String   @id @default(cuid())
  projectId  String   @unique
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  wordCount  Int      @default(0)
  estSeconds Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Scene {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order         Int
  title         String
  voiceText     String      @db.Text
  imagePrompt   String?     @db.Text
  videoPrompt   String?     @db.Text
  // Оценка по тексту дробная: на короткой сцене десятая доля — заметная
  // часть длины, а округление до целой её съедает.
  durationSec   Float?
  status        SceneStatus @default(PENDING)
  assets        Asset[]
  activeFrameId String?
  activeVideoId String?
  activeVoiceId String?
  activeMusicId String?
  createdAt     DateTime    @default(now())

  @@index([projectId, order])
}

enum SceneStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model Asset {
  id        String      @id @default(cuid())
  // Ассет принадлежит либо сцене, либо проекту (базовая музыка) — ровно одному
  // из двух. Оба поля nullable, потому что в SQL это не выразить строже.
  sceneId   String?
  scene     Scene?      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      AssetType
  provider  String
  prompt    String      @db.Text
  status    AssetStatus @default(QUEUED)
  url       String?
  // Реальная длительность файла (ffprobe). Для картинок и заглушек — null.
  durationSec Float?
  errorMsg  String?
  createdAt DateTime    @default(now())

  @@index([sceneId, createdAt])
  @@index([projectId, createdAt])
}

enum AssetType {
  IMAGE
  VIDEO
  VOICE
  MUSIC
}

enum AssetStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}
